#!/usr/bin/env bash
# Подмена pg_restore: --list печатает TOC дампа; иначе «восстанавливает» db.txt.
set -euo pipefail
[ -n "${FAKE_ROOT:-}" ] || { echo "fake-pg_restore: FAKE_ROOT unset" >&2; exit 99; }
echo "pg_restore $*" >>"${FAKE_ROOT}/state/calls.log"
list=0
for arg in "$@"; do [ "${arg}" = "--list" ] && list=1; done
# Файл дампа — существующий путь среди позиционных аргументов; цель -f не дамп.
file=""
target=""
prev=""
for arg in "$@"; do
    if [ "${prev}" = "-f" ]; then target="${arg}"; prev=""; continue; fi
    if [[ "${arg}" != -* ]] && [ -f "${arg}" ]; then file="${arg}"; fi
    prev="${arg}"
done
[ -n "${file}" ] || { echo "fake-pg_restore: no dump file in $*" >&2; exit 99; }
if [ "${list}" = "1" ]; then
    # -a: настоящий custom-format дамп бинарный, но pg_restore --list печатает текст.
    grep -a '^TOC-' "${file}" || true
    exit 0
fi
# pg_restore -f /dev/null — только чтение дампа, база не трогается.
if [ -n "${target}" ]; then
    cat "${file}" >/dev/null
    exit 0
fi
# Кластер задаёт только явный -h: без него (кластер по умолчанию) или с чужим сокетом — отказ.
if [ -n "${FAKE_PG_SOCKET:-}" ]; then
    got=""; prev=""
    for arg in "$@"; do [ "${prev}" = "-h" ] && got="${arg}"; prev="${arg}"; done
    if [ "${got}" != "${FAKE_PG_SOCKET}" ]; then
        echo "fake-pg: wrong cluster (-h '${got}', want '${FAKE_PG_SOCKET}')" >&2
        exit 1
    fi
fi
if [ "${FAKE_FAIL_PG_RESTORE:-0}" = "1" ]; then
    echo "fake-pg_restore: injected restore failure" >&2
    exit 1
fi
# -d <база>: база хаба — state/db.txt, любая другая — state/pgdb/<имя>.txt; несуществующая — отказ.
dbname="${HUB_PG_DB:-canterlot}"; prev=""
for arg in "$@"; do [ "${prev}" = "-d" ] && dbname="${arg}"; prev="${arg}"; done
if [ "${dbname}" = "${HUB_PG_DB:-canterlot}" ]; then
    data="${FAKE_ROOT}/state/db.txt"
else
    data="${FAKE_ROOT}/state/pgdb/${dbname}.txt"
fi
[ -f "${data}" ] || { echo "pg_restore: error: connection to server failed: FATAL:  database \"${dbname}\" does not exist" >&2; exit 1; }
cp "${file}" "${data}"
