#!/usr/bin/env bash
# Подмена docker для тестов. compose run запрещён громко (dry-run и проверки
# обязаны обходиться exec в запущенном контейнере).
set -euo pipefail
[ -n "${FAKE_ROOT:-}" ] || { echo "fake-docker: FAKE_ROOT unset" >&2; exit 99; }
echo "docker ${FAKE_HOST:-local} $*" >>"${FAKE_ROOT}/state/calls.log"

if [ "${1:-}" = "exec" ]; then
    shift
    encs=""
    asset=""
    # Пропускаем опции exec (-i/-e NAME=VALUE), затем CONTAINER.
    while (($#)); do
        case "$1" in
            -i) shift ;;
            -e) case "$2" in ENCS=*) encs="${2#ENCS=}" ;; ASSET=*) asset="${2#ASSET=}" ;; esac; shift 2 ;;
            -*) shift ;;
            *) break ;;
        esac
    done
    shift || true  # CONTAINER
    # Одноразовый loopback-Caddy: скрипт приходит на stdin, отвечаем заголовками
    # по каждой кодировке, с метками старта и останова, как настоящий скрипт.
    if [ "${1:-}" = "sh" ] && [ "${2:-}" = "-s" ]; then
        cat >"${FAKE_ROOT}/state/probe-script.sh"
        printf '%s' "${asset}" >"${FAKE_ROOT}/state/probe-asset"
        if [ "${FAKE_PROBE_BUSY:-0}" = "1" ]; then echo "probe: port 18080 already in use"; exit 4; fi
        echo "probe: loopback caddy pid 4242 started on 127.0.0.1:18080"
        for enc in ${encs}; do
            echo "probe-enc: ${enc}"
            if [ "${FAKE_ENCODING_FAIL:-}" = "${enc}" ]; then
                printf 'HTTP/1.1 200 OK\r\nVary: Accept-Encoding\r\n\r\n'
            else
                printf 'HTTP/1.1 200 OK\r\nContent-Encoding: %s\r\nVary: Accept-Encoding\r\n\r\n' "${enc}"
            fi
        done
        [ "${FAKE_PROBE_NO_STOP:-0}" = "1" ] || echo "probe: loopback caddy pid 4242 stopped"
        exit 0
    fi
    # Чтение «порт закрыт?» после пробы.
    if [ "${1:-}" = "sh" ] && [ "${2:-}" = "-c" ]; then
        if [ "${FAKE_PROBE_PORT_OPEN:-0}" = "1" ]; then echo open; else echo closed; fi
        exit 0
    fi
    case "$1" in
        cat)
            case "$2" in
                /srv/canterlot/web/build/_app/version.json) cat "${FAKE_ROOT}/container/version.json" ;;
                *) echo "fake-docker: exec cat unknown path $2" >&2; exit 99 ;;
            esac
            ;;
        printenv)
            case "$2" in
                GODEBUG) printf '%s' "${FAKE_GODEBUG:-tlsmlkem=0}" ;;
                CANTERLOT_CSP)
                    if [ "${FAKE_FAIL_CSP_READ:-0}" = "1" ]; then
                        echo "fake-docker: injected CSP read failure" >&2
                        exit 1
                    fi
                    cat "${FAKE_ROOT}/container/csp" ;;
                *) echo "fake-docker: exec printenv unknown var $2" >&2; exit 99 ;;
            esac
            ;;
        caddy)
            shift
            if [ "${1:-}" = "validate" ]; then
                [ "${FAKE_CADDY_VALIDATE:-0}" = "0" ] || { echo "fake-docker: caddy validate failed" >&2; exit 1; }
                echo "Valid configuration"
            else
                echo "fake-docker: exec caddy unknown: $*" >&2; exit 99
            fi
            ;;
        *) echo "fake-docker: exec unknown: $*" >&2; exit 99 ;;
    esac
    exit 0
fi

# Идентификатор контейнера: меняется при каждом recreate (compose up).
if [ "${1:-}" = "inspect" ]; then
    cat "${FAKE_ROOT}/state/caddy-id" 2>/dev/null || echo "caddy-id-0"
    exit 0
fi

if [ "${1:-}" = "compose" ]; then
    shift
    case "$1" in
        config) exit "${FAKE_COMPOSE_OK:-0}" ;;
        up)
            if [ "${FAKE_FAIL_CADDY_UP:-0}" = "1" ]; then
                echo "fake-docker: injected compose up failure" >&2
                exit 1
            fi
            # Тестовая задержка для детерминированного попадания сигналом в PWA-фазу.
            # command sleep: тесты сжимают функцию sleep, но это окно должно остаться реальным.
            if [ -n "${FAKE_CADDY_UP_DELAY:-}" ]; then command sleep "${FAKE_CADDY_UP_DELAY}"; fi
            # Симуляция recreate: контейнер видит свежие build и env.
            build_link="${WEB_SITES_BASE:?}/build"
            cp "${build_link}/_app/version.json" "${FAKE_ROOT}/container/version.json"
            sed 's/^CANTERLOT_CSP="//; s/"$//' "${WEB_ENV:?}" >"${FAKE_ROOT}/container/csp"
            n="$(sed 's/caddy-id-//' "${FAKE_ROOT}/state/caddy-id" 2>/dev/null || echo 0)"
            printf 'caddy-id-%s\n' "$((n + 1))" >"${FAKE_ROOT}/state/caddy-id"
            ;;
        run) echo "fake-docker: 'compose run' must not be used (use exec)" >&2; exit 99 ;;
        *) echo "fake-docker: compose unknown: $*" >&2; exit 99 ;;
    esac
    exit 0
fi
echo "fake-docker: unknown: $*" >&2
exit 99
