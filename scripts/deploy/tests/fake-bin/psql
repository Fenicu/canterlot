#!/usr/bin/env bash
# Подмена psql: отвечает на запросы скриптов по шаблонам из файлов состояния.
# Ничего, кроме чтения state/db.txt и сценарных файлов.
set -euo pipefail
[ -n "${FAKE_ROOT:-}" ] || { echo "fake-psql: FAKE_ROOT unset" >&2; exit 99; }
echo "psql $*" >>"${FAKE_ROOT}/state/calls.log"

sql="${*: -1}"
if [ -n "${FAKE_PSQL_FAIL_MATCH:-}" ] && [[ "${sql}" == *"${FAKE_PSQL_FAIL_MATCH}"* ]]; then
    echo "fake-psql: injected failure for query" >&2
    exit 1
fi
# -d <база>: у снесённой базы (нет db.txt) соединиться можно только с обслуживающей postgres.
# База хаба (HUB_PG_DB) — state/db.txt и state/db-oid, любая другая — state/pgdb/<имя>.txt и .oid.
pg_data() {
    if [ "$1" = "${HUB_PG_DB:-canterlot}" ]; then printf '%s' "${FAKE_ROOT}/state/db.txt"; else printf '%s' "${FAKE_ROOT}/state/pgdb/$1.txt"; fi
}
pg_oid() {
    if [ "$1" = "${HUB_PG_DB:-canterlot}" ]; then
        printf '%s' "${FAKE_PG_DBOID:-$(cat "${FAKE_ROOT}/state/db-oid" 2>/dev/null || echo 16384)}"
    else
        tr -d '\n' <"${FAKE_ROOT}/state/pgdb/$1.oid"
    fi
}
dbname=""; prevarg=""
for arg in "$@"; do [ "${prevarg}" = "-d" ] && dbname="${arg}"; prevarg="${arg}"; done
if [ -n "${dbname}" ] && [ "${dbname}" != "postgres" ] && [ ! -f "$(pg_data "${dbname}")" ]; then
    echo "psql: error: connection to server failed: FATAL:  database \"${dbname}\" does not exist" >&2
    exit 2
fi
db="${FAKE_ROOT}/state/db.txt"
migr_max=0
failed=0
if [ -f "${db}" ]; then
    migr_max="$(grep '^MIGR_MAX=' "${db}" | cut -d= -f2 || echo 0)"
    failed="$(grep '^FAILED=' "${db}" | cut -d= -f2 || echo 0)"
fi
# Строки исполнений не в running: state/exec-states, строки "id state [N final]".
# С N и final строка отвечает final после N запросов состояний (where id in):
# так сценарий моделирует делегата, чья строка starting доходит до running.
states_n=0
[ -f "${FAKE_ROOT}/state/states-queries" ] && states_n="$(cat "${FAKE_ROOT}/state/states-queries")"
exec_state_of() {
    awk -v id="$1" -v n="${states_n}" '$1 == id { if ($3 != "" && n >= $3) print $4; else print $2; exit }' \
        "${FAKE_ROOT}/state/exec-states" 2>/dev/null || true
}
running_ids() {
    cat "${FAKE_ROOT}/state/live-ids" 2>/dev/null || true
    if [ -f "${FAKE_ROOT}/state/exec-states" ]; then
        while read -r id _; do
            [ "$(exec_state_of "${id}")" = "running" ] && printf '%s\n' "${id}"
        done <"${FAKE_ROOT}/state/exec-states"
    fi
    return 0
}
case "${sql}" in
    *"|| ' ' || state from executions where id in ("*)
        states_n=$((states_n + 1))
        printf '%s' "${states_n}" >"${FAKE_ROOT}/state/states-queries"
        for id in $(printf '%s' "${sql}" | grep -o "'[0-9a-f-]\{36\}'" | tr -d "'"); do
            if grep -qx "${id}" "${FAKE_ROOT}/state/live-ids" 2>/dev/null; then
                printf '%s running\n' "${id}"
            else
                st="$(exec_state_of "${id}")"
                [ -z "${st}" ] || printf '%s %s\n' "${id}" "${st}"
            fi
        done ;;
    *"select count(*) from executions where state='running'"* | *"select count(*) from executions where state = 'running'"*)
        tr ' ' '\n' <"${FAKE_ROOT}/state/live-ids" 2>/dev/null | grep -c . || true ;;
    *"select id::text from executions where state='running'"*)
        running_ids ;;
    *"select distinct conversation_id"*)
        cat "${FAKE_ROOT}/state/live-convs" 2>/dev/null || true ;;
    *"from commands where conversation_id in"*)
        printf '%s' "${FAKE_OPEN_SI:-0}" ;;
    *"information_schema.tables where table_name='compactions'"*)
        printf '%s' "${FAKE_HAS_COMPACTIONS:-1}" ;;
    *"from compactions where finished_at is null"*)
        printf '%s' "${FAKE_OPEN_COMP:-0}" ;;
    *"select oid::text from pg_database where datname = '"*)
        # oid базы по имени; нет базы — пустой ответ.
        name="${sql#*datname = \'}"; name="${name%%\'*}"
        if [ -f "$(pg_data "${name}")" ]; then pg_oid "${name}"; fi ;;
    *"alter database "*" rename to "*)
        # Как настоящий ALTER DATABASE … RENAME TO: источник обязан быть, имя назначения — свободно.
        from="${sql#*alter database }"; from="${from%% *}"
        to="${sql#* rename to }"; to="${to%% *}"
        if [ ! -f "$(pg_data "${from}")" ]; then echo "ERROR:  database \"${from}\" does not exist" >&2; exit 1; fi
        if [ -f "$(pg_data "${to}")" ]; then echo "ERROR:  database \"${to}\" already exists" >&2; exit 1; fi
        oid="$(pg_oid "${from}")"
        mkdir -p "${FAKE_ROOT}/state/pgdb"
        /bin/mv "$(pg_data "${from}")" "$(pg_data "${to}")"
        /bin/rm -f "${FAKE_ROOT}/state/pgdb/${from}.oid"
        if [ "${to}" = "${HUB_PG_DB:-canterlot}" ]; then
            printf '%s\n' "${oid}" >"${FAKE_ROOT}/state/db-oid"
        else
            printf '%s\n' "${oid}" >"${FAKE_ROOT}/state/pgdb/${to}.oid"
        fi
        printf 'ALTER DATABASE' ;;
    *"select 1 from pg_database"*)
        # Есть ли база: 1, если db.txt на месте.
        if [ -f "${FAKE_ROOT}/state/db.txt" ]; then printf '1'; fi ;;
    *"pg_control_system"*)
        # Идентификатор кластера: FAKE_PG_SYSID, иначе state/pg-sysid (его меняет крючок посреди
        # прогона), иначе значение стенда по умолчанию.
        sysid="${FAKE_PG_SYSID:-$(tr -d '\n' <"${FAKE_ROOT}/state/pg-sysid" 2>/dev/null || echo 7000000000000000001)}"
        if [[ "${sql}" == *"pg_database"* ]]; then
            printf '%s %s' "${sysid}" "${FAKE_PG_DBOID:-$(cat "${FAKE_ROOT}/state/db-oid" 2>/dev/null || echo 16384)}"
        else
            printf '%s' "${sysid}"
        fi ;;
    *"from _sqlx_migrations order by version"*)
        if [ -f "${FAKE_ROOT}/state/db-migrations.txt" ]; then
            cat "${FAKE_ROOT}/state/db-migrations.txt"
        else
            for ((v = 1; v <= migr_max; v++)); do printf '%s c%s 1\n' "${v}" "${v}"; done
        fi ;;
    *"from pg_stat_activity"*)
        printf '%s' "${FAKE_HUB_CONNS:-3}" ;;
    *"coalesce(max(version),0) from _sqlx_migrations"*)
        printf '%s' "${migr_max}" ;;
    *"from _sqlx_migrations where not success"*)
        printf '%s' "${failed}" ;;
    *"array_to_string(capabilities"*)
        printf '%s' "${FAKE_CAPABILITIES:-claude_histories_v1,path_probe_v1,pilot_v1,session_tools_v1}" ;;
    *"from machine_harnesses"*)
        printf '%s' "${FAKE_HARNESSES:-claude_code,codex,opencode}" ;;
    *"string_agg"*)
        awk '{printf "%s:running ", substr($1,1,8)}' "${FAKE_ROOT}/state/live-ids" 2>/dev/null || true ;;
    *"from machines where id ="*)
        # "<availability>:<возраст reported_at в секундах>" как отдаёт настоящий запрос.
        printf '%s' "${FAKE_MACHINE_ROW:-available:1}" ;;
    *"select hibernate_requested from executions where id ="*)
        # Исполнения, погашенные засыпанием хаба: state/hibernated-ids, по id в строке.
        id="$(printf '%s' "${sql}" | grep -o "'[0-9a-f-]*'" | tr -d "'" | tail -1)"
        if grep -qx "${id}" "${FAKE_ROOT}/state/hibernated-ids" 2>/dev/null; then printf 't'; else printf 'f'; fi ;;
    *"from executions where id ="*)
        id="$(printf '%s' "${sql}" | grep -o "'[0-9a-f-]*'" | tr -d "'" | tail -1)"
        if grep -qx "${id}" "${FAKE_ROOT}/state/live-ids" 2>/dev/null; then
            printf 'running:null'
        elif grep -q "^${id} " "${FAKE_ROOT}/state/ended-ids" 2>/dev/null; then
            grep "^${id} " "${FAKE_ROOT}/state/ended-ids" | head -1 | cut -d' ' -f2
        else
            printf 'missing:null'
        fi ;;
    *) echo "fake-psql: unmocked query: ${sql}" >&2; exit 99 ;;
esac
