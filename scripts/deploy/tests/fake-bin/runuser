#!/usr/bin/env bash
# Подмена runuser: отбрасывает 'runuser -u USER --', выполняет остальное
# (внутренние команды резолвятся в fake-bin через PATH).
set -euo pipefail
user=""
while [ $# -gt 0 ]; do
    case "$1" in
        -u) user="$2"; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
[ -n "${user}" ] || { echo "fake-runuser: no user" >&2; exit 99; }
# Подменённые бинари видят, от чьего имени их запустили.
export FAKE_RUNUSER="${user}"
exec "$@"
