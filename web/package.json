{
  "name": "canterlot-web",
  "private": true,
  "license": "MIT",
  "version": "1.19.2",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/precompress.mjs \"${PWA_BUILD_DIR:-build}\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "test:unit": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:ui": "playwright test e2e/ui",
    "test:stack": "playwright test e2e/stack",
    "test:perf": "playwright test e2e/perf --project=phone",
    "test:parity": "playwright test e2e/parity",
    "screenshots": "PW_SCREENSHOTS=1 playwright test e2e/screenshots/readme.spec.ts --project=phone",
    "stack:build": "cargo build -p canterlot-hub -p canterlot-worker --features canterlot-worker/synthetic-adapter"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@sveltejs/kit": "3.1.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "html-to-image": "1.11.13",
    "mammoth": "1.13.0",
    "markdown-it": "15.0.3",
    "read-excel-file": "9.3.14",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.32",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
