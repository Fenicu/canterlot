# Образец значений своего стенда для scripts/deploy/*, build-release.sh и gate-remote.sh.
# Скопируйте файл в .superpowers/site.env (каталог не отслеживается git) или укажите
# свой путь в CANTERLOT_SITE_ENV. Здесь только имена и пути: секретов быть не должно.
# Запись вида : "${VAR:=значение}" задаёт переменную, только если её ещё нет в
# окружении, поэтому явная переменная окружения главнее этого файла, а файл —
# главнее нейтральных умолчаний скриптов.

# --- SSH и Proxmox ---
: "${HUB_SSH:=hub}"                                       # ssh-алиас хаба (root)
: "${WEB_SSH:=web}"                                       # ssh-алиас хоста Caddy
: "${PROXMOX_SSH:=proxmox}"                               # ssh-алиас гипервизора Proxmox VE
: "${PROXMOX_NODE:=pve-node1}"                            # нода PVE, на которой живёт CT хаба
: "${HUB_CTID:=101}"                                      # vmid контейнера хаба
: "${HUB_IP:=192.0.2.10}"                                 # внутренний адрес хаба

# --- Хаб ---
: "${HUB_BASE:=/opt/canterlot}"                           # корень установки хаба
: "${HUB_RELEASES:=/opt/canterlot/releases}"              # каталог релизов хаба
: "${HUB_CURRENT:=/opt/canterlot/current}"                # ссылка на текущий релиз хаба
: "${HUB_CONFIG:=/etc/canterlot/hub.toml}"                # конфиг хаба
: "${HUB_UNIT:=canterlot-hub}"                            # systemd-юнит хаба
: "${HUB_BACKUP_DIR:=/var/backups/canterlot}"             # каталог дампов базы
: "${HUB_PG_SOCKET:=/var/run/postgresql}"                 # сокет PostgreSQL
: "${HUB_PG_DB:=canterlot}"                               # база хаба
: "${HUB_PG_USER:=canterlot}"                             # роль PostgreSQL хаба
: "${PBS_STORAGE:=backup_storage}"                        # хранилище Proxmox Backup Server
: "${HUB_GEOIP_PATH:=}"                                   # подмена пути GeoIP-базы (только тесты)
: "${GEOIP_MAX_AGE_DAYS:=35}"                             # возраст GeoIP-базы, после которого её обновляют

# --- PWA и Caddy ---
: "${SITE_ORIGIN:=https://hub.example.com}"               # публичный адрес PWA
: "${WSS_ORIGIN:=wss://hub.example.com}"                  # адрес WebSocket для проверки CSP
: "${WEB_SITES_BASE:=/srv/caddy/sites/canterlot}"         # каталог сайтов Caddy
: "${WEB_RELEASES:=/srv/caddy/sites/canterlot/releases}"  # каталог релизов PWA
: "${WEB_BUILD_LINK:=/srv/caddy/sites/canterlot/build}"   # ссылка на раздаваемую сборку PWA
: "${WEB_ENV:=/srv/caddy/canterlot.env}"                  # env-файл Caddy с CANTERLOT_CSP
: "${WEB_COMPOSE_DIR:=/srv/caddy}"                        # каталог docker compose Caddy
: "${WEB_CONTAINER:=caddy}"                               # имя контейнера Caddy
: "${WEB_CONTAINER_VERSION_JSON:=/srv/canterlot/web/build/_app/version.json}" # version.json внутри контейнера
: "${SITE_CODES:=hub.example.com:200 git.example.com:200}" # ожидаемые коды сайтов через пробел

# --- Воркер ---
: "${WORKER_BASE:=${HOME}/.local/opt/canterlot}"          # корень установки воркера
: "${WORKER_RELEASES:=${HOME}/.local/opt/canterlot/releases}" # каталог релизов воркера
: "${WORKER_CURRENT:=${HOME}/.local/opt/canterlot/current}"   # ссылка на текущий релиз воркера
: "${WORKER_CONFIG:=${HOME}/.config/canterlot/worker.toml}"   # конфиг воркера
: "${WORKER_DATA:=${HOME}/.local/state/canterlot-worker}"     # данные воркера
: "${WORKER_UNIT:=canterlot-worker}"                      # имя пользовательского юнита
: "${WORKER_SOCKET_DIR:=/run/user/$(id -u)/canterlot}"    # сокеты живых сессий
: "${WORKER_UNIT_DIR:=${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user}" # каталог пользовательских юнитов
: "${RETAIN_COUNT:=3}"                                    # сколько релизов держать на компонент

# --- Сборка (build-release.sh, gate-remote.sh) ---
: "${CANTERLOT_BUILD_HOST:=canterlot-build}"              # ssh-алиас сборочной машины
: "${CANTERLOT_SITE_ORIGIN:=https://hub.example.com}"     # SITE_ORIGIN для csp.txt
: "${CANTERLOT_WSS_ORIGIN:=wss://hub.example.com}"        # WSS_ORIGIN для csp.txt
